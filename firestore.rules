rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidExam(data) {
      return data.examCode is string && data.examCode.size() >= 4 && data.examCode.size() <= 12 &&
             data.examCode.matches('^[A-Z0-9\\-]+$') &&
             data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
             data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 80 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80 &&
             data.totalQuestions is int && data.totalQuestions >= 5 && data.totalQuestions <= 100 &&
             data.optionStyle in ['ABCD', 'BN_KAKH'] &&
             data.marksPerCorrect is number && data.marksPerCorrect >= 0.25 && data.marksPerCorrect <= 10.0 &&
             data.negativeMark is number && data.negativeMark >= 0.0 && data.negativeMark <= 5.0 &&
             data.answerKey is list && data.answerKey.size() == data.totalQuestions &&
             data.answerKey.size() >= 5 && data.answerKey.size() <= 100 &&
             data.answerKey[0] is string &&
             data.status in ['active', 'closed'] &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidExamCode(data) {
      return data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80 &&
             data.status in ['active', 'closed'] &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSubmission(data) {
      return data.examId is string && data.examId.size() >= 1 && data.examId.size() <= 128 &&
             data.examCode is string && data.examCode.size() >= 4 && data.examCode.size() <= 12 &&
             data.examTitle is string && data.examTitle.size() >= 2 && data.examTitle.size() <= 120 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80 &&
             data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
             data.submittedByUid is string && data.submittedByUid.size() >= 1 && data.submittedByUid.size() <= 128 &&
             data.scannedByRole in ['student', 'teacher'] &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 80 &&
             data.studentRoll is string && data.studentRoll.size() >= 1 && data.studentRoll.size() <= 40 &&
             data.optionStyle in ['ABCD', 'BN_KAKH'] &&
             data.detectedAnswers is list && data.detectedAnswers.size() >= 5 && data.detectedAnswers.size() <= 100 &&
             data.detectedAnswers[0] is string &&
             data.correctAnswers is list && data.correctAnswers.size() == data.detectedAnswers.size() &&
             data.correctAnswers[0] is string &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 100 &&
             data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 100 &&
             data.unansweredCount is int && data.unansweredCount >= 0 && data.unansweredCount <= 100 &&
             (data.correctCount + data.wrongCount + data.unansweredCount) == data.detectedAnswers.size() &&
             data.score is number && data.score >= -500.0 && data.score <= 1000.0 &&
             data.maxScore is number && data.maxScore > 0.0 && data.maxScore <= 1000.0 &&
             data.percentage is number && data.percentage >= 0.0 && data.percentage <= 100.0 &&
             data.aiConfidence in ['high', 'medium', 'low'] &&
             (!('aiNotes' in data) || (data.aiNotes is string && data.aiNotes.size() <= 300));
    }

    match /exams/{examId} {
      allow get: if isSignedIn() && isValidId(examId) &&
                    (existing().teacherId == request.auth.uid || existing().status == 'active');
      allow list: if isSignedIn() && existing().teacherId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(examId) &&
                       incoming().teacherId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'examCode', 'teacherId', 'teacherName', 'title', 'subject',
                         'totalQuestions', 'optionStyle', 'marksPerCorrect', 'negativeMark',
                         'answerKey', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'examCode', 'teacherId', 'teacherName', 'title', 'subject',
                         'totalQuestions', 'optionStyle', 'marksPerCorrect', 'negativeMark',
                         'answerKey', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidExam(incoming());

      allow update: if isSignedIn() &&
                       isValidId(examId) &&
                       isValidExam(incoming()) &&
                       existing().teacherId == request.auth.uid &&
                       incoming().teacherId == existing().teacherId &&
                       incoming().examCode == existing().examCode &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'subject', 'totalQuestions', 'optionStyle',
                         'marksPerCorrect', 'negativeMark', 'answerKey', 'status', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(examId) && existing().teacherId == request.auth.uid;
    }

    match /examCodes/{examCode} {
      allow get: if isSignedIn() && isValidId(examCode);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(examCode) &&
                       examCode.size() >= 4 && examCode.size() <= 12 &&
                       incoming().teacherId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'examId', 'teacherId', 'title', 'subject', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'examId', 'teacherId', 'title', 'subject', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       isValidExamCode(incoming()) &&
                       existsAfter(/databases/$(database)/documents/exams/$(incoming().examId)) &&
                       getAfter(/databases/$(database)/documents/exams/$(incoming().examId)).data.teacherId == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(examCode) &&
                       isValidExamCode(incoming()) &&
                       existing().teacherId == request.auth.uid &&
                       incoming().teacherId == existing().teacherId &&
                       incoming().examId == existing().examId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'subject', 'status', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(examCode) && existing().teacherId == request.auth.uid;
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn() && isValidId(submissionId) &&
                    (existing().submittedByUid == request.auth.uid || existing().teacherId == request.auth.uid);
      allow list: if isSignedIn() &&
                     (existing().submittedByUid == request.auth.uid || existing().teacherId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(submissionId) &&
                       incoming().submittedByUid == request.auth.uid &&
                       incoming().keys().hasAll([
                         'examId', 'examCode', 'examTitle', 'subject', 'teacherId', 'submittedByUid',
                         'scannedByRole', 'studentName', 'studentRoll', 'optionStyle',
                         'detectedAnswers', 'correctAnswers', 'correctCount', 'wrongCount',
                         'unansweredCount', 'score', 'maxScore', 'percentage', 'aiConfidence', 'submittedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'examId', 'examCode', 'examTitle', 'subject', 'teacherId', 'submittedByUid',
                         'scannedByRole', 'studentName', 'studentRoll', 'optionStyle',
                         'detectedAnswers', 'correctAnswers', 'correctCount', 'wrongCount',
                         'unansweredCount', 'score', 'maxScore', 'percentage', 'aiConfidence', 'aiNotes', 'submittedAt'
                       ]) &&
                       incoming().submittedAt is timestamp &&
                       incoming().submittedAt <= request.time &&
                       isValidSubmission(incoming()) &&
                       exists(/databases/$(database)/documents/exams/$(incoming().examId)) &&
                       get(/databases/$(database)/documents/exams/$(incoming().examId)).data.teacherId == incoming().teacherId &&
                       (get(/databases/$(database)/documents/exams/$(incoming().examId)).data.status == 'active' ||
                        get(/databases/$(database)/documents/exams/$(incoming().examId)).data.teacherId == request.auth.uid);

      allow update: if false;

      allow delete: if isSignedIn() && isValidId(submissionId) &&
                       (existing().submittedByUid == request.auth.uid || existing().teacherId == request.auth.uid);
    }
  }
}
